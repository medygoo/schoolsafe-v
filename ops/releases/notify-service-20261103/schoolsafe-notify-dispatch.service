[Unit]
Description=SchoolSafe - distributeur des notifications (feed, e-mail Brevo, WhatsApp)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/schoolsafe-notify-dispatch.lock /usr/bin/docker exec schoolsafe-rosario php /var/www/html/schoolsafe-notify-dispatch.php --once --limit=100
TimeoutStartSec=120
