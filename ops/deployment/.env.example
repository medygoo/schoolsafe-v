# SchoolSafe — modèle d'environnement VPS. Copier en ".env" puis renseigner.
# AUCUN vrai secret ne doit être commité : .env reste hors Git (root 600 conseillé).

# --- Base PostgreSQL (service db) ---
# Image alignée sur le standard VPS documenté (PostgreSQL 17.11-bookworm).
POSTGRES_IMAGE=postgres:17.11-bookworm
POSTGRES_DB=schoolsafe
POSTGRES_USER=schoolsafe
# 32 caractères minimum, généré localement (ex: openssl rand -base64 32).
POSTGRES_PASSWORD=CHANGEME-longueur-minimale-32-caracteres

# --- Application ---
SCHOOLSAFE_DEFAULT_SYEAR=2026
SCHOOLSAFE_TIMEZONE=Africa/Kinshasa
# Notifications/erreurs par e-mail (optionnel, vide = désactivé).
SCHOOLSAFE_NOTIFY_EMAIL=
SCHOOLSAFE_ERRORS_EMAIL=

# --- Edge (profil compose "edge" uniquement ; inutile si Caddy tourne sur l'hôte) ---
# Domaine public réservé, ex: schoolsafe.179-198-195-15.sslip.io
SCHOOLSAFE_DOMAIN=schoolsafe.example.sslip.io

# --- Console AppSmith (admin-console-bridge.php) ---
# Jeton de service : generer avec `openssl rand -hex 32`. L'application AppSmith
# l'envoie dans l'en-tete X-SchoolSafe-Console-Token. Vide => endpoint en 503.
SCHOOLSAFE_CONSOLE_TOKEN=

# --- Binding web côté hôte ---
# VPS cible : 18080 (Caddy y pointe déjà ; 8080 est occupé par AppSmith).
SCHOOLSAFE_WEB_BIND=127.0.0.1:8080
